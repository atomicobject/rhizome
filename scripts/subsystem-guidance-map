#!/usr/bin/env node
// Generates the folder -> guidance-note mapping for code-review tools (Greptile)
// from `code-paths` frontmatter in docs/reference/subsystems/*.md.
// Usage: scripts/subsystem-guidance-map [--json | --greptile]
//   (default)    markdown table of (path, note) pairs
//   --json       JSON array of {path, note, summary} pairs
//   --greptile   .greptile/config.json (one scoped rule per note)
import { readFileSync, readdirSync } from "node:fs";
import { join, dirname, relative } from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = join(dirname(fileURLToPath(import.meta.url)), "..");
const dir = join(repoRoot, "docs", "reference", "subsystems");
const json = process.argv.includes("--json");
const greptile = process.argv.includes("--greptile");

function parseFrontmatter(text, file) {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  if (!m) fail(`${file}: missing frontmatter`);
  const fm = { summary: null, codePaths: [] };
  let inPaths = false;
  for (const line of m[1].split("\n")) {
    if (/^code-paths:\s*$/.test(line)) {
      inPaths = true;
      continue;
    }
    if (inPaths) {
      const item = line.match(/^\s+-\s+(.+)$/);
      if (item) {
        fm.codePaths.push(item[1].trim().replace(/^["']|["']$/g, ""));
        continue;
      }
      inPaths = false;
    }
    const s = line.match(/^summary:\s*(.+)$/);
    if (s) fm.summary = s[1].trim().replace(/^["']|["']$/g, "");
  }
  return fm;
}

function fail(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}

const rows = [];
const notes = [];
for (const name of readdirSync(dir).sort()) {
  if (!name.endsWith(".md") || name === "README.md" || name === "overview.md") continue;
  const file = join(dir, name);
  const fm = parseFrontmatter(readFileSync(file, "utf8"), name);
  if (!fm.summary) fail(`${name}: missing summary in frontmatter`);
  if (fm.codePaths.length === 0) fail(`${name}: missing code-paths in frontmatter`);
  const note = relative(repoRoot, file);
  const slug = name.replace(/\.md$/, "");
  notes.push({ slug, note, summary: fm.summary, codePaths: fm.codePaths });
  for (const p of fm.codePaths) rows.push({ path: p, note, summary: fm.summary });
}

rows.sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));

// Turn a code-paths entry (a directory or a single file) into a Greptile scope glob.
function toScope(p) {
  return /\.[a-z]+$/i.test(p) ? p : `${p}/**`;
}

if (greptile) {
  const config = {
    // GENERATED by scripts/subsystem-guidance-map --greptile from the
    // code-paths frontmatter of docs/reference/subsystems/*.md. Do not edit by
    // hand; re-run the script after changing a note's code-paths.
    ignorePatterns: [
      ".agents/skills/impeccable/**",
      ".claude/skills/impeccable/**",
      ".github/skills/impeccable/**",
    ].join("\n"),
    rules: notes.map((n) => ({
      id: `subsystem-${n.slug}`,
      rule: `Code under these paths is governed by ${n.note}. ${n.summary} Treat that note's Design constraints and "Review checklist — problems to catch" as the review contract for this change, and flag any violation.`,
      scope: n.codePaths.map(toScope),
      severity: "medium",
      enabled: true,
    })),
  };
  console.log(JSON.stringify(config, null, 2));
} else if (json) {
  console.log(JSON.stringify(rows, null, 2));
} else {
  console.log("| Path | Guidance note |");
  console.log("| --- | --- |");
  for (const r of rows) console.log(`| \`${r.path}\` | ${r.note} |`);
}
