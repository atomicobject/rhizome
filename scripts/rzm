#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

case "$(uname -s)" in
	Darwin)
		platform=darwin
		exe=rzm
		;;
	Linux)
		platform=linux
		exe=rzm
		;;
	CYGWIN*|MINGW*|MSYS*)
		platform=windows
		exe=rzm.exe
		;;
	*)
		printf 'scripts/rzm: unsupported platform: %s\n' "$(uname -s)" >&2
		exit 1
		;;
esac

target="$repo_root/bin/$platform/$exe"
if [ ! -x "$target" ]; then
	printf 'scripts/rzm: expected executable at %s\n' "$target" >&2
	printf 'Run make build first, or make build-all to build every platform binary.\n' >&2
	exit 1
fi

exec "$target" "$@"
