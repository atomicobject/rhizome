{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome",
  "version": "0.0.0",
  "identifier": "com.atomicobject.rhizome",
  "build": {
    "beforeDevCommand": "npm run rzm && npm run dev",
    "beforeBuildCommand": "npm run rzm && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["shell"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Open your repositories in Rhizome",
    "externalBin": ["binaries/rzm", "binaries/team-api"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5RDM5OTUwQjk1MDI0QzcKUldUSEpGQzVVSm5UV1ZJaTllSHZoOEZSalJpbWhvbkVJeVBaQWpFZWtiMnY0TjJXeGZGY3JnWlEK",
      "endpoints": ["https://github.com/atomicobject/rhizome/releases/latest/download/latest.json"]
    }
  }
}
