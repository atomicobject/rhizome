{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome",
  "version": "0.1.0",
  "identifier": "com.atomicobject.rhizome",
  "build": {
    "beforeDevCommand": "npm run bridge && npm run dev",
    "beforeBuildCommand": "npm run bridge && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["shell"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Open your repositories in Rhizome",
    "externalBin": ["binaries/rhizome-desktop-bridge"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
