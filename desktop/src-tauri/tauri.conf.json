{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome",
  "version": "0.0.0",
  "identifier": "com.atomicobject.rhizome",
  "build": {
    "beforeDevCommand": "npm run rzm && npm run dev",
    "beforeBuildCommand": "npm run rzm && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [
        "shell"
      ],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Open your repositories in Rhizome",
    "externalBin": [
      "binaries/rzm"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4M0Q3RDM3NjBFMjAxRDgKUldUWUFlSmdOMzA5eUlEMlhtSXlCdjZ3bzJVdy9WNW1ENFE5VUxaQzBoa3VxVHFVZWNZeVZ5VEEK",
      "endpoints": [
        "https://github.com/atomicobject/rhizome/releases/latest/download/latest.json"
      ]
    }
  }
}
